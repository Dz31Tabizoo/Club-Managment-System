<Window x:Class="WPF_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:WPF_APP.Components"
        Title="Pro Club Manager 2026" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1E1E1E" Grid.Column="0" CornerRadius="0 20 20 0">
            <StackPanel Margin="15">
                <TextBlock Text="DASHBOARD" Foreground="Lime" FontSize="18" FontWeight="Bold" Margin="10,30,10,40"/>

                <Button Command="{Binding ShowPlayersCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton }" 
                        Foreground="White" Height="50" Margin="0,5">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <materialDesign:PackIcon Kind="AccountGroup" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Players" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="White" Height="50" Margin="0,5">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <materialDesign:PackIcon Kind="Shield" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Teams" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="All Players" Foreground="White" FontSize="28" FontWeight="Light" Margin="10,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal">
                    <components:PlayerCard />
                    <components:PlayerCard />
                    <components:PlayerCard />
                    <components:PlayerCard />
                    <components:PlayerCard />
                    <components:PlayerCard />
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>