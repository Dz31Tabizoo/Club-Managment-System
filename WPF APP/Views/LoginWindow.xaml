<Window x:Class="WPF_APP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoginWindow" Height="500" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*"/>
            
        </Grid.ColumnDefinitions>

        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#59955D" Offset="1.1" />
                    <GradientStop Color="#315844" Offset="0.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas>
                    <Polygon Points="0,120 220,200 0,330" Fill="#BDF03E" Opacity="0.1" />
                    <Polygon Points="100,400 200,370, 180,470" Fill="#BDF03E" Opacity="0.15" Canvas.Top="-38" Canvas.Left="10" />
                    <Ellipse Width="40" Height="40" Fill="#BDF03E" Opacity="0.2" Canvas.Left="246" Canvas.Top="340"/>
                    <Ellipse Width="20" Height="20" Fill="#BDF03E" Opacity="0.2" Canvas.Left="59" Canvas.Top="335"/>
                </Canvas>

                <StackPanel>
                    <TextBlock Text="Club Management" 
                               Foreground="#FFFFFF"
                               FontFamily="/Assets/Fonts/#Montserrat"
                               FontWeight="Bold"
                               FontSize="30" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,5" Height="33"/>
                    <TextBlock Text="Ecosystem" 
                                Foreground="#FFFFFF"
                                FontFamily="/Assets/Fonts/#Montserrat"
                                FontWeight="Bold"
                                FontSize="30" 
                                HorizontalAlignment="Center" 
                                Height="35"/>

                    <Image Source="/Assets/Images/CMS LOGO.png" Stretch="Fill" Height="220" Width="200" Margin="0,20,0,0" Opacity="0.7"/>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/Images/NumidixLogoSQR.png" Opacity="0.8" Margin="0" Width="100" HorizontalAlignment="Left" Grid.Column="0"/>
                        <TextBlock Text="Numidix Lab" 
                                   Foreground="#FcFcFc"
                                   FontFamily="/Assets/Fonts/#Montserrat"
                                   FontWeight="DemiBold"
                                   FontSize="30" 
                                   Margin="5,35,0,0"
                                   Grid.Column="1"
                                   
                                   FontStretch="UltraExpanded"
                                   HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="Gérer. Performer. Réussir." 
                               Foreground="#FcFcFc"
                               FontFamily="/Assets/Fonts/#Montserrat"
                               FontWeight="DemiBold"
                               FontSize="20" 
                               Margin="0,25,0,0"
                               FontStretch="UltraExpanded"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="bord1" 
                Background="#FcFcFc" 
                Grid.Column="1" 
                CornerRadius="0 10 10 0" 
                HorizontalAlignment="Center" 
                Width="480" Height="500" 
                VerticalAlignment="Top">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Grid.Background>
                    <ImageBrush ImageSource="/Assets/Images/ClubLOGO-Photoroom.png" Stretch="Uniform" Opacity="0.02" />
                </Grid.Background>


                <Button x:Name="Close"                                 
                        BorderThickness="0"
                        Content="X"          
                        FontSize="24"
                        FontFamily="/Assets/Fonts/#Montserrat"
                        FontWeight="DemiBold"
                        Cursor="Hand"
                        Margin="0,5,5,0"
                        Height="30"
                        Width="30" 
                        Grid.Column="2" Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#315844"/>
                            <Setter Property="Foreground" Value="#BDF03E"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#59955D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="Connexion à l'application"
                           FontSize="30"
                           FontWeight="DemiBold"
                           FontFamily="/Assets/Fonts/#Montserrat"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Grid.Row="1"
                           Margin="20,20,0,5">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#315844" Offset="0.5"/>
                            <GradientStop Color="#59955D" Offset="0.8"/>
                            <GradientStop Color="#BEF238" Offset="1.1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <StackPanel Grid.Row="2" Orientation="Vertical"  HorizontalAlignment="Center" Height="300" Width="350" Margin="20,50,0,0" VerticalAlignment="Top" 
                             >

                    <Border BorderThickness="1" BorderBrush="#315844" Margin="0,60,0,20" CornerRadius="5 0 5 0" Width="280" >
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Images/utilisateur.png" Height="24" Width="24" Margin="8" />

                            <TextBox x:Name="txtUserName" 
                                     Grid.Column="1" 
                                     Text="Nom d'utilisateur" 
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     FontSize="15"
                                     Opacity="0.6"
                                     BorderThickness="0"
                                     Margin="8,0,0,0"
                                     Foreground="#315844"
                                     GotFocus="txtUserName_GotFocus"
                                     LostFocus="txtUserName_LostFocus"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border BorderThickness="1" BorderBrush="#315844" Margin="0,7" CornerRadius="5 0 5 0" Width="280">
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Assets/Images/mot-de-passe.png" Height="24" Width="24" Margin="8" />

                            <TextBlock Text="Mot de passe"
                                       x:Name="textPasswordPlaceholder"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="10,0,0,0"
                                       Foreground="#315844"
                                       Opacity="0.6"
                                       IsHitTestVisible="False"/>

                            <PasswordBox x:Name="txtPassWord" 
                                         Grid.Column="1" 
                                         PasswordChar="●"
                                         Width="225"
                                         Height="25"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="15"
                                         Foreground="#315844"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,5,0"
                                         PasswordChanged="txtPassWord_PasswordChanged"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnLogin2"                                 
                                 BorderThickness="0"
                                 Content="Se connecter"          
                                 FontSize="18"
                                 FontFamily="/Assets/Fonts/#Montserrat"
                                 FontWeight="DemiBold"
                                 Cursor="Hand"
                                 Margin="0,30,0,0"
                                 Height="40"
                                 Width="180" >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#315844"/>
                                <Setter Property="Foreground" Value="#BDF03E"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#59955D"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

