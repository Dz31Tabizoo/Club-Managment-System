<Window x:Class="WPF_APP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        mc:Ignorable="d"
        Title="LoginWindow" Height="500" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*" />

        </Grid.ColumnDefinitions>




        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="1">
                    <GradientStop Color="#2a93d5" Offset="1.1" />
                    <GradientStop Color="#154a6a" Offset="0.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas>
                    <Polygon Points="0,120 220,200 0,330" Fill="#62A7CF" Opacity="0.2" />
                    <Polygon Points="100,400 200,370, 180,470" Fill="#62A7CF" Opacity="0.28" HorizontalAlignment="Left" Canvas.Top="-38" VerticalAlignment="Top" Canvas.Left="10" />
                    <Ellipse Width="40" Height="40" Fill="#62A7CF" Opacity="0.35" Canvas.Left="246" Canvas.Top="340" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Width="20" Height="20" Fill="#62A7CF" Opacity="0.35" Canvas.Left="59" Canvas.Top="335" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                </Canvas>

                <StackPanel >

                    <TextBlock Text="Club Management Ecosystem" 
                               Foreground="#F1F7F6"
                               FontFamily="Segoe UI" 
                               FontSize=" 20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,50,0,0"/>

                    <Image Source="/Assets/Images/CMS LOGO.png" Stretch="Fill" Height="220" Width="200" Margin="0,25,0,0" />
                    <Image Source="/Assets/Images/logo-Photoroom.png " Width="180" Margin="0,30" OverridesDefaultStyle="True"/>
                    <TextBlock Text="Gérer. Performer. Réussir." 
                               Foreground="#F1F7F6"
                               FontFamily="/Resources/Noto/NotoSans-Regular.ttf#Noto Sans" 
                               FontSize=" 20" 
                               FontWeight="SemiBold"
                               
                               HorizontalAlignment="Center"                              Margin="0,0,0,0"/>


                </StackPanel>



            </Grid>
        </Border>




       
        
        
        
        
        <Border Background="#FFFFFF" 
                Grid.Column="1" 
                CornerRadius="0 10 10 0" 
                HorizontalAlignment="Center" 
                Width="480" Height="500" 
                VerticalAlignment="Top" >
            
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Width="330" Height="300">

                <Border BorderThickness="1" BorderBrush="Black" Margin="70 7" CornerRadius="0 10 0 15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                       <Image Source="/Assets/Images/Username Icon.png" Height="20" Stretch="Uniform" Margin="10,0,0,0"/>
                        <TextBlock x:Name="UserName" Text="Nom d'itulisateur" Grid.Column="1">
                            
                        </TextBlock>
                    </Grid>                                                                                      
                </Border>                                            
                           
            </StackPanel>
            
