<Window x:Class="WPF_APP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP.Views"
        xmlns:viewModel="clr-namespace:WPF_APP.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Title="MainWindow" Height="700" Width="1300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
         <!--Navigation Menu-->
        <Border Grid.Column="0" Background="{StaticResource PrimaryGreenBrush}" CornerRadius="15,0,0,15">

            <StackPanel>

                <StackPanel 
                            Height="100"
                            Margin="0,25,0,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>


                        <Image Grid.Column="0" Source= "/Assets/Images/CMS LOGO.png" Width="80" Height="80" HorizontalAlignment="Left" Margin="10,0,0,0"/>

                    <TextBlock Text="Club Management" 
                                Foreground="#FFFFFF"
                                FontFamily="/Assets/Fonts/#Montserrat"
                                FontWeight="Bold"
                                FontSize="15"
                               Margin="0,20,0,0"
                               Grid.Column="1"/>
                    
                    <TextBlock Text="Ecosystem" 
                                Foreground="#FFFFFF"
                                FontFamily="/Assets/Fonts/#Montserrat"
                                FontWeight="Bold"
                                FontSize="15"
                               Margin="30,45,0,0"
                               Grid.Column="1"/>
                    </Grid>
                </StackPanel>
                
                <!--MenuButtons-->
                

                <RadioButton Style="{StaticResource MenuButtonStyle}" 
             Tag="{StaticResource GreenLimeBrush}" 
             GroupName="MenuPrincipal">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Dashboard" Style="{StaticResource menuButtonsIcon}"/>
                        <TextBlock Text="Tableau de bord" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" 
                             Tag="{StaticResource GreenLimeBrush}" 
                             GroupName="MenuPrincipal">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Users" Style="{StaticResource menuButtonsIcon}"/>
                        <TextBlock Text="Effectif" Style="{StaticResource menuButtonText}" Margin="25,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                
                <RadioButton Style="{StaticResource MenuButtonStyle}" 
             Tag="{StaticResource GreenLimeBrush}" 
             GroupName="MenuPrincipal">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="CalendarTimesOutline" Style="{StaticResource menuButtonsIcon}"/>
                        <TextBlock Text="Événements" Style="{StaticResource menuButtonText}" Margin="25,0,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" 
             Tag="{StaticResource GreenLimeBrush}" 
             GroupName="MenuPrincipal">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="CartArrowDown" Style="{StaticResource menuButtonsIcon}"/>
                        <TextBlock Text="Dépenses" Style="{StaticResource menuButtonText}" Margin="25,0,0,0"/>
                    </StackPanel>
                </RadioButton>

               
                

            </StackPanel>
            
        
        
        
        
        </Border>



        <!--Main Content Section-->

        <Border Grid.Column="1" Background="{StaticResource WhiteBrush}" CornerRadius="0,15,15,0">
        </Border>


        


    </Grid>

    
    
</Window>
