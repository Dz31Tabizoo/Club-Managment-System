<UserControl x:Class="ClubManagementSystem.Components.PlayerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="220" Width="180">

    <materialDesign:Card UniformCornerRadius="10" Margin="5" Background="#252525" 
                         materialDesign:ElevationAssist.Elevation="Dp2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#303030" CornerRadius="10 10 0 0">
                <materialDesign:PackIcon Kind="Account" Width="60" Height="60" 
                                         Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="LimeGreen" CornerRadius="0 10 0 10" Padding="8 2">
                <TextBlock Text="Active" FontSize="10" FontWeight="Bold" Foreground="Black"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="10">
                <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="Bold" FontSize="16" 
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="FW" Foreground="LightGray" FontSize="12" Margin="0 0 10 0"/>
                    <TextBlock Text="#10" Foreground="Lime" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
                
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>