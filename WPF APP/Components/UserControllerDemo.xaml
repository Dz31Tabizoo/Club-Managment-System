<UserControl x:Class="WPF_APP.Components.UserControllerDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_APP.Components"
             mc:Ignorable="d" FontSize="24" FontFamily="Segoe UI Light"
             d:DesignHeight="450" d:DesignWidth="800"
             > 
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="1" Grid.Row="1" FontSize="28" FontWeight="Bold"
           Text="Carte du Coach"/>

        <TextBlock Grid.Column="1" Grid.Row="3"  FontSize="18" FontWeight="Bold"
           Text="    Nom et Prénom" />
        <TextBox x:Name="NameTextBox" Grid.Column="2" Grid.Row="3" Width="250" BorderBrush="Black" />
        <Button x:Name="SunbmitButton" Content="Submit" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" Margin="10" Click="SunbmitButton_Click"/> 
    </Grid>
</UserControl>
