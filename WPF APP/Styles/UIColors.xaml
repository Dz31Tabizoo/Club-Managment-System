<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#315844"/>
    <SolidColorBrush x:Key="GreenLimeBrush" Color="#BDF03e"/>
    <SolidColorBrush x:Key="LightGrayBgBrush" Color="#E3e5e5"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FcFcFc"/>
    <SolidColorBrush x:Key="GreenClaireBrush" Color="#ADD171"/>
    <SolidColorBrush x:Key="MidumGreenBgBrush" Color="#59955D"/>


    <Style x:Key="BorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource LightGrayBgBrush}"/>
    </Style>

</ResourceDictionary>