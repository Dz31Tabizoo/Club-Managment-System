<Window x:Class="ClubManagementSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClubManagementSystem.Helpers"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Login" Height="550" Width="850"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" MouseDown="Window_MouseDown"
        FontFamily="/Assets/Fonts/#Montserrat">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringVisConverter"/>
        <conv:StringNotEmptyToVisibleConverter x:Key="ErrorConverter"/>
        
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource WhiteBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="#000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="15 0 0 15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{Binding Color, Source={StaticResource PrimaryGreenBrush}}" Offset="0.5"/>
                        <GradientStop Color="{Binding Color, Source={StaticResource GreenLimeBrush}}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="CLUB MANAGEMENT" Foreground="{StaticResource WhiteBrush}" 
                               FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="ECOSYSTEM" Foreground="{StaticResource WhiteBrush}" 
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-5,0,20"/>

                    <Image Source="/Assets/Images/file logo test.png" Height="250" Width="250" Stretch="UniformToFill" Margin="0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Image Source="/Assets/Images/NumidixLogoSQR.png" Width="45" Height="45"/>
                        <TextBlock Text="Numidix Lab" Foreground="{StaticResource WhiteBrush}" 
                                   FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="0 15 15 0">
                <Grid>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                            Click="Close_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="✕" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                        <ProgressBar IsIndeterminate="{Binding IsLoggingIn}" 
                                     Height="4" 
                                     VerticalAlignment="Top"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource GreenLimeBrush}"
                                     Visibility="{Binding IsLoggingIn, Converter={StaticResource InverseBooleanConverter}}" />
                        <TextBlock Text="Connexion" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                        <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,25">
                            <Grid Height="40">
                                <fa:ImageAwesome Icon="User" Foreground="{StaticResource PrimaryGreenBrush}" Width="15" HorizontalAlignment="Left" Margin="5,0"/>
                                <TextBlock Text="Typez votre user name ici" VerticalAlignment="Center" Margin="30,0,0,0"
                                           Foreground="#888" Opacity="0.6" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=txtUserName, Converter={StaticResource StringVisConverter}}"/>
                                <TextBox x:Name="txtUserName"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsLoggingIn , Converter={StaticResource InverseBooleanConverter}}"
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         VerticalContentAlignment="Center" 
                                         FontSize="15" Padding="30,0,0,0" 
                                         Foreground="#333"/>
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,2" BorderBrush="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,10">
                            <Grid Height="40">
                                <fa:ImageAwesome Icon="Lock" Foreground="{StaticResource PrimaryGreenBrush}" Width="15" HorizontalAlignment="Left" Margin="5,0"/>
                                <TextBlock x:Name="textPasswordPlaceholder" Text="Tapez votre mot de passe ici" VerticalAlignment="Center" Margin="30,0,0,0"
                                           Foreground="#888"                                           
                                           Opacity="0.6" IsHitTestVisible="False"/>
                                <PasswordBox x:Name="txtPassWord"
                                             IsEnabled="{Binding IsLoggingIn , Converter={StaticResource InverseBooleanConverter}}"
                                             BorderThickness="0" 
                                             Background="Transparent" 
                                             VerticalContentAlignment="Center" 
                                             FontSize="15" 
                                             Padding="30,0,0,0"
                                             PasswordChanged="txtPassWord_PasswordChanged"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,10" MinHeight="25">
                            <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center"
                Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorConverter}}">

                                <fa:ImageAwesome Icon="ExclamationTriangle" 
                         Foreground="#E74C3C" 
                         Width="14" 
                         Margin="0,0,8,0" 
                         VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ErrorMessage}" 
                                           Foreground="#E74C3C" 
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="SE CONNECTER" 
                                Height="45" 
                                Margin="0,25,0,0" 
                                Style="{StaticResource LoginButtonStyle}" 
                                IsEnabled="{Binding IsLoggingIn , Converter={StaticResource InverseBooleanConverter}}"
                                Cursor="Hand"
                                Command="{Binding LoginCommand}"
                                CommandParameter="{Binding ElementName=txtPassWord}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>