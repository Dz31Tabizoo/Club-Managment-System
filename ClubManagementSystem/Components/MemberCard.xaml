<UserControl x:Class="ClubManagementSystem.Components.MemberCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:fa="http://schemas.fontawesome.io/icons/"             
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <!-- Instantiate only the needed role UI (Player OR Staff) -->
        <DataTemplate x:Key="PlayerRoleTemplate">
            <UniformGrid Columns="2">
                <md:Card Margin="0,0,10,0" UniformCornerRadius="12" Padding="15" Background="{StaticResource GreenClaireBrush}">
                    <StackPanel>
                        <TextBlock Text="CATÉGORIE"
                                   FontSize="10"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   FontWeight="Bold"/>

                        <TextBox Text="{Binding CategoryDisplay, Mode=OneWay}"
                                 Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 IsReadOnly="True"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"/>

                        <ComboBox ItemsSource="{Binding Allcategories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="CategoryName"
                                  Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                  md:HintAssist.Hint="Sélectionner..."
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    </StackPanel>
                </md:Card>

                <md:Card Margin="10,0,0,0"
                         UniformCornerRadius="12"
                         Padding="15"
                         Background="{StaticResource WhiteBrush}"
                         BorderBrush="{StaticResource LightGrayBgBrush}"
                         BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="INSCRIPTION" FontSize="10" Foreground="Gray" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SubscriptionStatus}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryGreenBrush}"/>
                    </StackPanel>
                </md:Card>
            </UniformGrid>
        </DataTemplate>

        <DataTemplate x:Key="StaffRoleTemplate">
            <md:Card UniformCornerRadius="12" Padding="15" Background="{StaticResource GreenClaireBrush}">
                <StackPanel>
                    <TextBlock Text="SPÉCIALISATION" FontSize="10" Foreground="{StaticResource PrimaryGreenBrush}" FontWeight="Bold"/>
                    <TextBox Text="{Binding Specialization}" IsReadOnly="{Binding IsReadOnly}" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </md:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Border md:ElevationAssist.Elevation="Dp0"
            CornerRadius="20"
            Background="{StaticResource WhiteBrush}"
            ClipToBounds="True"
            Opacity="1">
        <Border.Triggers>
            <!-- Very light fade-in (kept separate from DialogHost transitions) -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <!--<Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="2"/>
        </Border.Effect>-->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Profile & Quick Stats -->
            <Border Grid.Column="0" Background="#f1f7f6" Padding="20">
                <StackPanel>
                    <!-- ID Badge ([-_-]) -->
                    <Border Background="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Center" 
                            Padding="12,4" CornerRadius="12" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PersonID, StringFormat='ID: {0}'}" Foreground="White" 
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <!-- Profile Image -->
                    <Grid HorizontalAlignment="Center">
                        <Border Width="160" Height="160" CornerRadius="80" 
                                BorderBrush="{StaticResource PrimaryGreenBrush}" BorderThickness="3"
                                RenderOptions.BitmapScalingMode="LowQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PhotoImage}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- Edit Photo Overlay -->
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Width="32" Height="32" Background="{StaticResource GreenLimeBrush}" BorderBrush="Transparent"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter},ConverterParameter=Inverse}">
                        <md:PackIcon Kind="CameraPlus" Width="16" Height="16" Foreground="{StaticResource LightGrayBgBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Position}" Foreground="{StaticResource PrimaryGreenBrush}"
                               
                               FontWeight="Black" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,5"/>

                    <Separator Background="{StaticResource GreenClaireBrush}" Margin="10,10,10,5"/>

                    <!-- Stats Grid -->
                    <UniformGrid Columns="2">
                        <StackPanel Margin="2">
                            <TextBlock Text="DATE DE NAISSANCE" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Age}" 
                                       Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                       FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>

                            <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        md:HintAssist.Hint="Date de naissance"
                                        md:TextFieldAssist.HasClearButton="True"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter},ConverterParameter=Inverse}"
                                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter},ConverterParameter=Inverse}"
                                        FontSize="14" 
                                        Width="160"/>
                        </StackPanel>
                        
                        <StackPanel Margin="2">
                            <TextBlock Text="GENRE" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Gender}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Player Specific Mini Stats -->
                    <StackPanel Visibility="{Binding IsPlayer, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                        <Border Background="{StaticResource WhiteBrush}" CornerRadius="10" Padding="10" Margin="0,5">
                            <DockPanel>
                                <TextBlock Text="PRÉSENCE" FontSize="9" Foreground="Gray" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="{Binding AttendanceColor}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding AttendanceRate, StringFormat='{}{0}%'}" FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Background="{Binding SubscriptionColor}" CornerRadius="10" Padding="10">
                            <DockPanel>
                                <TextBlock Text="STATUT" FontSize="9" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SubscriptionStatus}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Content: Details -->
            <Grid Grid.Column="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Contact Info -->
                    <RowDefinition Height="Auto"/>
                    <!-- Role Details -->
                    <RowDefinition Height="*"/>
                    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Name Section -->
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="PRÉNOM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding FirstName}" IsReadOnly="{Binding IsReadOnly}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,12" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="NOM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding LastName}" IsReadOnly="{Binding IsReadOnly}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,12" FontSize="14"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Contact Info Card -->
                <md:Card Grid.Row="1" UniformCornerRadius="12" Padding="15" Margin="0,0,0,20" Background="#f1f7f6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <md:PackIcon Kind="Phone" Width="14" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock Text="TÉLÉPHONE" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <TextBox Text="{Binding Phone}" IsReadOnly="{Binding IsReadOnly}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GreenClaireBrush}" Background="Transparent"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <md:PackIcon Kind="Email" Width="14" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock Text="E-MAIL" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <TextBox Text="{Binding Email}" IsReadOnly="{Binding IsReadOnly}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GreenClaireBrush}" Background="Transparent"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <md:PackIcon Kind="MapMarker" Width="14" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock Text="ADRESSE" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                            <TextBox Text="{Binding Address}" IsReadOnly="{Binding IsReadOnly}" TextWrapping="Wrap" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GreenClaireBrush}" Background="Transparent"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Role Specific Info -->
                <ContentControl Grid.Row="2" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource StaffRoleTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PlayerRoleTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- Action Footer -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <!-- Edit Mode Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter},ConverterParameter=Inverse}">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="ANNULER" 
                                Command="{Binding CancelCommand}" Margin="0,0,10,0" Foreground="Gray"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryGreenBrush}" BorderBrush="Transparent"
                                Command="{Binding SaveCommand}" Width="150" Height="40" md:ButtonAssist.CornerRadius="20">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ENREGISTRER" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- View Mode Actions -->
                    <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                >

                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Content="ÉDITER" 
                                Command="{Binding EditCommand}" 
                                Margin="0,0,20,0" Foreground="{StaticResource PrimaryGreenBrush}"/>

                        <Button Style="{StaticResource MaterialDesignFlatSecondaryLightButton}" Content="FERMER" 
                                Command="{Binding CloseCommand}" Background="#f1f7f6" 
                                Foreground="{StaticResource PrimaryGreenBrush}"
                                Width="85" Height="30" md:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>